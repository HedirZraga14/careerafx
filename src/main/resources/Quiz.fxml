<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>

<AnchorPane xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.QuizController" prefWidth="1500.0" prefHeight="900.0">

    <!-- VBox centré dans l'AnchorPane -->
    <VBox spacing="20" alignment="CENTER"
          AnchorPane.topAnchor="50.0" AnchorPane.leftAnchor="50.0" AnchorPane.rightAnchor="50.0" AnchorPane.bottomAnchor="50.0"
          style="-fx-background-color: #f0f4f8; -fx-font-family: 'Roboto', sans-serif;">

        <!-- Timer -->
        <Text fx:id="timerText" text="⏰Temps restant: 30" style="-fx-font-size: 22px; -fx-font-weight: bold; color: #ff6600;"/>

        <!-- Container for Questions (replacing ListView) -->
        <VBox fx:id="questionsContainer" spacing="15" visible="false" />

        <!-- HBox pour les deux boutons sur la même ligne -->
        <HBox spacing="20" alignment="CENTER">
            <!-- Start Quiz Button -->
            <Button fx:id="startQuizButton" text="🚀 Démarrer le Quiz" onAction="#startQuiz"
                    style="-fx-font-size: 18px; -fx-padding: 12 24; -fx-background-color: #4e9fd1; -fx-text-fill: white; -fx-border-radius: 8px; cursor: pointer;"/>

            <!-- Submit Button -->
            <Button fx:id="submitButton" text="✅Soumettre" onAction="#submitQuiz"
                    style="-fx-font-size: 18px; -fx-padding: 12 24; -fx-background-color: #28a745; -fx-text-fill: white; -fx-border-radius: 8px;" disable="true"/>
        </HBox>
    </VBox>

</AnchorPane>
