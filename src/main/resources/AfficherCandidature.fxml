<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane xmlns="http://javafx.com/javafx/19"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.AfficherCandidaturesUserController"
            style="-fx-background-color: linear-gradient(to bottom right, #f8fafc, #e0e7ff);"
            prefWidth="1200.0" prefHeight="800.0">

    <children>
        <VBox spacing="30" alignment="TOP_CENTER" layoutX="20.0" layoutY="20.0" prefWidth="1060.0">
            <padding>
                <Insets top="30" right="50" bottom="30" left="50"/>
            </padding>

            <children>

                <!-- Titre -->
                <Text text="Liste des Candidatures" style="-fx-fill: #2c3e50; -fx-font-weight: bold;">
                    <font>
                        <Font name="System Bold" size="40"/>
                    </font>
                </Text>

                <!-- Liste des candidatures -->
                <ListView fx:id="listView" prefHeight="400.0" maxWidth="1000.0" prefWidth="1000.0" style="-fx-border-color: #ddd; -fx-border-width: 1;"/>

                <!-- Boutons d'action -->
                <HBox spacing="30" alignment="CENTER" prefWidth="1000.0">
                    <padding>
                        <Insets top="30" right="30" bottom="30" left="30"/>
                    </padding>

                    <children>
                        <!-- Zone gauche -->
                        <HBox spacing="20" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                            <children>
                                <Button fx:id="supprimerBtn" text="Supprimer"
                                        onAction="#supprimerCandidature"
                                        style="-fx-background-color: #dc3545; -fx-text-fill: white; -fx-font-size: 16px; -fx-padding: 10 20; -fx-background-radius: 5; -fx-border-radius: 5; -fx-effect: dropshadow(gaussian, #000, 5, 0, 2, 2);"/>
                            </children>
                        </HBox>

                        <!-- Espace extensible -->
                        <Region HBox.hgrow="ALWAYS"/>

                        <!-- Zone droite -->
                        <HBox spacing="20" alignment="CENTER_RIGHT">
                            <children>
                                <Button fx:id="accepterBtn" text="Accepter"
                                        onAction="#accepterCandidature"
                                        style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-font-size: 16px; -fx-padding: 10 20; -fx-background-radius: 5; -fx-border-radius: 5; -fx-effect: dropshadow(gaussian, #000, 5, 0, 2, 2);"/>
                                <Button fx:id="refuserBtn" text="Refuser"
                                        onAction="#refuserCandidature"
                                        style="-fx-background-color: #ffc107; -fx-text-fill: black; -fx-font-size: 16px; -fx-padding: 10 20; -fx-background-radius: 5; -fx-border-radius: 5; -fx-effect: dropshadow(gaussian, #000, 5, 0, 2, 2);"/>
                            </children>
                        </HBox>
                    </children>
                </HBox>

            </children>
        </VBox>
    </children>
</AnchorPane>
